<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE struts PUBLIC "-//Apache Software Foundation//DTD Struts Configuration 2.1//EN" 
"http://struts.apache.org/dtds/struts-2.1.dtd">

<struts>
    <package name="mobile-api" namespace="/api" extends="json-default">

        <action name="getCompany" class="com.api.MobileApiAction" method="fetchCompanies">
            <result type="json">
                <param name="includeProperties">status, companyList\[\d+\]\..*</param>
            </result>
        </action>

        <action name="login" class="com.api.MobileApiAction" method="processLogin">
            <result type="json">
                <param name="includeProperties">status, token</param>
            </result>
        </action>

        <action name="getDashboard" class="com.api.MobileApiAction" method="fetchDashboard">
            <result type="json">
                <param name="includeProperties">status, dashboardData.*</param>
            </result>
        </action>
        
        <action name="fetchDashboard" class="com.api.MobileApiAction" method="fetchDashboard">
    <result type="json"></result>
</action>


<action name="updateState" class="com.api.MobileApiAction" method="updateStateToCollection">
    <result type="json">
        <param name="includeProperties">status</param>
    </result>
</action>

<action name="submitBooking" class="com.api.MobileApiAction" method="submitBooking">
    <result type="json">
        <param name="includeProperties">status, dashboardData.*</param>
    </result>
</action>

<action name="getBrands" class="com.api.MobileApiAction" method="fetchBrands">
    <result type="json">
        <param name="includeProperties">status, dropdownData.*</param>
    </result>
</action>

<action name="getModels" class="com.api.MobileApiAction" method="fetchModels">
    <result type="json">
        <param name="includeProperties">status, dropdownData.*</param>
    </result>
</action>

<action name="getClients" class="com.api.MobileApiAction" method="fetchClients">
    <result type="json">
        <param name="includeProperties">status, dropdownData.*</param>
    </result>
</action>

<action name="submitDelivery" class="com.api.MobileApiAction" method="submitDelivery">
    <result type="json">
        <param name="includeProperties">status, dashboardData.*</param>
    </result>
</action>

<action name="submitCollection" class="com.api.MobileApiAction" method="submitCollection">
    <result type="json">
        <param name="includeProperties">status, dashboardData.*</param>
    </result>
</action>

<action name="getClientList" class="com.api.MobileApiAction" method="getClientList">
    <result type="json"><param name="includeProperties">status, dropdownData.*</param></result>
</action>

<action name="getFleetList" class="com.api.MobileApiAction" method="getFleetList">
    <result type="json"><param name="includeProperties">status, dropdownData.*</param></result>
</action>

<action name="getSalesAgentList" class="com.api.MobileApiAction" method="getSalesAgentList">
    <result type="json"><param name="includeProperties">status, dropdownData.*</param></result>
</action>

<action name="getDriverList" class="com.api.MobileApiAction" method="getDriverList">
    <result type="json"><param name="includeProperties">status, dropdownData.*</param></result>
</action>

<action name="getLocationList" class="com.api.MobileApiAction" method="getLocationList">
    <result type="json"><param name="includeProperties">status, dropdownData.*</param></result>
</action>
    </package>
</struts>